# Environment variables & secrets
# IMPORTANT: .env.example is intentionally committed as a template.
# NEVER commit .env (it contains real API keys).
.env
.env.*
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
venv/
venv-*/
ENV/

# Databases & persistent storage (never commit)
*.db
*.db-shm
*.db-wal
*.db-*
*.sqlite
*.sqlite3

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local

# Logs (may contain sensitive runtime data)
*.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch / temp work
scratch/
*.tmp

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
