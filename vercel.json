{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ai-assistant/frontend && npm run build",
  "outputDirectory": "ai-assistant/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}